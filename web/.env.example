# Server-only — the backend base URL this app's Route Handlers/Server Components call. Never
# exposed to the browser (no NEXT_PUBLIC_ prefix): the browser never talks to the API directly,
# only through this app, which is what keeps the access token out of client JS.
# In docker-compose, the backend service is reachable at http://app:8080.
API_BASE_URL=http://localhost:8080

# Encrypts the httpOnly session cookie (iron-session). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be at least 32 characters. Rotating it logs every session out.
SESSION_SECRET=change_me_at_least_32_characters_long

# Google OAuth Web client id (from Google Cloud Console — a Web application client, NOT the
# mobile ones already in the backend's GOOGLE_CLIENT_IDS). Its Authorized JavaScript origin must
# match wherever this app is served from. Public on purpose: the client id is not a secret, it is
# sent to Google directly from the browser to start the sign-in flow.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
