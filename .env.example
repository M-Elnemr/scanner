DB_NAME=umrah_scanner
DB_USERNAME=umrah_scanner
DB_PASSWORD=change_me

# Generate with: openssl rand -base64 32
JWT_SECRET=change_me

# Comma-separated OAuth2 client ids for Google Sign-In audience checks
GOOGLE_CLIENT_IDS=

# Leave empty in production. Set to "dev" only for local/dev testing.
SPRING_PROFILES_ACTIVE=

# Comma-separated list of allowed browser origins (e.g. https://app.example.com), or "*" for any
CORS_ALLOWED_ORIGINS=*

# Host port the app is exposed on
APP_PORT=8080

# --- web (Next.js frontend, deploy/nginx/scanner.conf proxies to it) ---

# Encrypts the frontend's httpOnly session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be at least 32 characters. Rotating it logs every session out.
WEB_SESSION_SECRET=change_me_at_least_32_characters_long

# Google OAuth Web client id (Google Cloud Console — a Web application client, distinct from the
# mobile ones already in GOOGLE_CLIENT_IDS above). Its Authorized JavaScript origin must match
# wherever this app is served from. Baked into the client bundle at image build time by the
# "Build and push web image" GitHub Actions workflow (see WEB_GOOGLE_CLIENT_ID repo secret), not
# read from this .env — changing it means re-running that workflow, not just a restart.

# Host port the web frontend is exposed on
WEB_PORT=3000

# Tag of ghcr.io/m-elnemr/scanner-web to pull. Leave as latest unless pinning to a specific build.
WEB_IMAGE_TAG=latest
